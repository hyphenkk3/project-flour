# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=your-resend-api-key
STAFF_NOTIFICATION_DISPATCH_SECRET=generate-a-long-random-secret
CRON_SECRET=generate-a-long-random-secret

# Supabase pg_cron sweep (not stored in git):
# Database custom config / ALTER DATABASE SET
#   app.settings.staff_notification_dispatch_url
#     = https://<deployment-host>/api/staff/notifications/dispatch
#   app.settings.staff_notification_dispatch_secret
#     = the same value as STAFF_NOTIFICATION_DISPATCH_SECRET
#       (or CRON_SECRET if that is the only secret set on Vercel)
